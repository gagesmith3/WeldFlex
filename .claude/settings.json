{
  "permissions": {
    "allow": [
      "Bash(./venv/Scripts/python.exe -m pytest *)",
      "Bash(python -m pytest *)",
      "PowerShell(python -m pytest *)",
      "PowerShell(./venv/Scripts/python.exe -m pytest *)",
      "PowerShell(.\\venv\\Scripts\\python.exe -m pytest *)",
      "Bash(./venv/Scripts/python.exe -m py_compile *)",
      "Bash(python -m py_compile *)",
      "PowerShell(python -m py_compile *)",
      "Bash(bash -n *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git stash list*)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "Bash(gh pr view*)",
      "Bash(gh repo view*)",
      "Bash(bash .claude/skills/hmi-ssh/scripts/hmi_preflight.sh*)",
      "Read(//c/Users/Gage/Desktop/WeldFlex/**)"
    ],
    "ask": [
      "Bash(ssh *)",
      "Bash(scp *)",
      "PowerShell(ssh *)",
      "PowerShell(scp *)",
      "Bash(git push *)",
      "PowerShell(git push *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "Bash(git reset --hard*)",
      "PowerShell(git reset --hard*)",
      "Bash(git clean -f*)",
      "PowerShell(git clean -f*)"
    ],
    "additionalDirectories": [
      "C:\\Users\\Gage\\Desktop\\WeldFlex\\.claude"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/venv/Scripts/python.exe\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_robot.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/venv/Scripts/python.exe\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_edit.py\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
