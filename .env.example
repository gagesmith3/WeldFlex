WELDFLEX_ROBOT_IP=192.168.58.2
WELDFLEX_CONTROLLER_HOST=192.168.58.2
# FR-16 realtime CNDE stream. Still the only force source; state, line and fault
# codes have already moved to the port-8083 feed below. Both run for now.
# Set this explicitly: the code default is 20005, which does not work here.
WELDFLEX_CNDE_PORT=20004
# Start with the one force signal at a conservative period; do not restore the SDK's 73-signal default.
WELDFLEX_CNDE_PERIOD_MS=20
# Controller status feed: a pushed frame every 100ms carrying program state,
# current line, fault codes, DI/DO, force and pose. Read-only, and read on its
# own socket and thread so it never queues behind an XML-RPC call. The send
# period is set on the pendant (system settings -> maintenance mode), not here.
WELDFLEX_STATUS_PORT=8083
# How long a frame stays usable. ~30 missed frames at the controller's slowest
# period — long enough to ride out a hiccup, short enough that nobody reads
# second-old force data believing it is live.
WELDFLEX_FEED_STALE_S=3.0
WELDFLEX_PROGRAM_PATH=/fruser/studCycle.lua
WELDFLEX_STUDS_DATA_PATH=/fruser/studs_data.lua
WELDFLEX_FAIRINO_PATH=C:/Users/Gage/Desktop/WeldFlex/fairino-python-sdk-main/windows
WELDFLEX_FTP_USER=fruser
WELDFLEX_FTP_PASS=fruser
PORT=5000
# Connection robustness: XML-RPC socket timeouts and failure thresholds for program runs
WELDFLEX_XMLRPC_TIMEOUT_S=12.0
WELDFLEX_PROBE_TIMEOUT_S=12.0
WELDFLEX_FAIL_THRESHOLD=30

# Dynamic stud-to-stud speed compensation. Leave disabled until dry-run timing
# measurements establish a conservative controller-specific model; restart the
# backend after changing any of these values.
WELDFLEX_DSC_CALIBRATED=0
WELDFLEX_DSC_RATE_100_PCT_MMS=180
WELDFLEX_DSC_FIXED_OVERHEAD_MS=0
WELDFLEX_DSC_SAFETY_MARGIN_MS=50
# Exact electrical trigger sent to the stud feeder. Mechanical reload continues
# after this pulse while the robot traverses to the next stud.
WELDFLEX_FEED_PULSE_MS=250

