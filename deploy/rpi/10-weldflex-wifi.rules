// Lets the WeldFlex backend (running as the kiosk user, not root) change Wi-Fi
// from Settings → Wi-Fi. Installed to /etc/polkit-1/rules.d/ by
// install_rpi_kiosk.sh, which fills in the kiosk user's name below.
//
// Why the filename starts with 10: polkit runs the rules from /etc and
// /usr/share together in filename order, and the first rule that returns a
// result decides. Debian's 49-polkit-pkla-compat.rules applies the vendor .pkla,
// which answers "no" to settings.modify.system for sudo/netdev users outside an
// active login session. A system service is never in an active session. A rule
// named 50-... never ran for that action (found on the kiosk 2026-09-24).
//
// Only the NetworkManager actions backend/wifi.py uses are granted. polkit cannot
// limit these to Wi-Fi profiles: settings.modify.system also covers the robot's
// eth0 profile. wifi.py enforces that limit instead. It only touches profiles of
// type 802-11-wireless, and it names the Wi-Fi interface in every command.
//
// wifi.share.protected is for Settings → Hotspot: without it, activating the
// shared-mode profile fails with "Not authorized to share connections via wifi"
// (found on the kiosk 2026-09-25). The hotspot always uses a WPA2 password, so
// wifi.share.open is not granted.
polkit.addRule(function (action, subject) {
    var allowed = [
        "org.freedesktop.NetworkManager.network-control",
        "org.freedesktop.NetworkManager.settings.modify.system",
        "org.freedesktop.NetworkManager.wifi.scan",
        "org.freedesktop.NetworkManager.enable-disable-wifi",
        "org.freedesktop.NetworkManager.wifi.share.protected"
    ];
    if (subject.user === "KIOSK_USER" && allowed.indexOf(action.id) >= 0) {
        return polkit.Result.YES;
    }
});
