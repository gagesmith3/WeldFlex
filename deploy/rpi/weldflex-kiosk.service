[Unit]
Description=WeldFlex Kiosk Browser
After=graphical.target network-online.target weldflex-update.service weldflex-backend.service
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/WeldFlex
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/pi/.Xauthority
Environment=WELDFLEX_KIOSK_URL=http://127.0.0.1:5000
Environment=WELDFLEX_BROWSER_CMD=chromium-browser
ExecStart=/home/pi/WeldFlex/deploy/rpi/kiosk-launch.sh
Restart=always
RestartSec=2

[Install]
WantedBy=graphical.target
