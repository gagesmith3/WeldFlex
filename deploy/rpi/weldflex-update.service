[Unit]
Description=WeldFlex Boot Update Check
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=pi
WorkingDirectory=/home/pi/WeldFlex
ExecStart=/home/pi/WeldFlex/deploy/rpi/update_on_boot.sh
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
